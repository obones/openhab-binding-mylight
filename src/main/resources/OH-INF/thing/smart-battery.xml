<?xml version="1.0" encoding="UTF-8"?>
<!-- MyLight Binding -->
<thing:thing-descriptions bindingId="mylight"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:thing="https://openhab.org/schemas/thing-description/v1.0.0"
	xsi:schemaLocation="https://openhab.org/schemas/thing-description/v1.0.0 https://openhab.org/schemas/thing-description-1.0.0.xsd">

	<!-- -->
	<!-- MyLight SmartBattery thing -->
	<!-- -->
	<thing-type id="smart-battery">
		<supported-bridge-type-refs>
			<bridge-type-ref id="mylight"/>
		</supported-bridge-type-refs>
		<label>@text/thing-type.mylight.smart-battery.label</label>
		<description>@text/thing-type.mylight.smart-battery.description</description>
		<category>Electricity</category>
		<channels>
			<channel id="charge-level" typeId="charge-level"/>
			<channel id="charge-energy" typeId="charge-energy"/>
			<channel id="instantaneous-charge-energy" typeId="instantaneous-charge-energy">
				<label>@text/channel.mylight.smart-battery.instantaneous-charge-energy.label</label>
				<description>@text/channel.mylight.smart-battery.instantaneous-charge-energy.description</description>
			</channel>
			<channel id="instantaneous-discharge-energy" typeId="instantaneous-charge-energy">
				<label>@text/channel.mylight.smart-battery.instantaneous-discharge-energy.label</label>
				<description>@text/channel.mylight.smart-battery.instantaneous-discharge-energy.description</description>
			</channel>
			<channel id="instantaneous-loss-energy" typeId="instantaneous-charge-energy">
				<label>@text/channel.mylight.smart-battery.instantaneous-loss-energy.label</label>
				<description>@text/channel.mylight.smart-battery.instantaneous-loss-energy.description</description>
			</channel>
		</channels>
		<properties>
			<property name="vendor">MyLight</property>
			<property name="deviceId"/>
			<property name="subscribed-capacity"/>
			<property name="last-updated"/>
			<property name="thingTypeVersion">1</property>
		</properties>
		<representation-property>device-id</representation-property>
		<config-description-ref uri="thing-type:mylight:smart-battery"/>
	</thing-type>
</thing:thing-descriptions>
